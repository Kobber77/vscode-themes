{
  "name": "st-patricks-day-theme",
  "displayName": "☘️ St. Patrick's Day Theme",
  "description": "A lucky green theme for St. Patrick's Day with emoji typing effects, comment emojis, snake and pot-of-gold gutter icons and a countdown to March 17.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "st patricks day",
    "green",
    "shamrock",
    "leprechaun",
    "clover",
    "irish",
    "dark",
    "emoji",
    "effects",
    "fun"
  ],
  "contributes": {
    "themes": [
      {
        "label": "☘️ St. Patrick's Day",
        "uiTheme": "vs-dark",
        "path": "./themes/st-patricks-day-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "stpatricks.cycleTheme",
        "title": "Cycle Color Theme",
        "category": "St. Patrick's"
      },
      {
        "command": "stpatricks.toggleEffects",
        "title": "Toggle Typing Effects",
        "category": "St. Patrick's"
      },
      {
        "command": "stpatricks.potOfGold",
        "title": "Find the Pot of Gold",
        "category": "St. Patrick's"
      }
    ],
    "configuration": {
      "title": "St. Patrick's Day",
      "properties": {
        "stpatricks.onlyWhenThemeActive": {
          "type": "boolean",
          "default": true,
          "description": "Only run effects while the ☘️ St. Patrick's Day color theme is active."
        },
        "stpatricks.typingEffects.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Pop a lucky emoji after the cursor while typing."
        },
        "stpatricks.typingEffects.every": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 50,
          "description": "Pop an emoji every N keystrokes."
        },
        "stpatricks.commentEmojis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show 🍀 after TODO, 🍺 FIXME, 🐍 BUG, 🎩 HACK, 🌈 XXX, 🪙 NOTE, 🍂 DEPRECATED in comments."
        },
        "stpatricks.gutterIcons.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Snake in the gutter on error lines, pot of gold on warning lines."
        },
        "stpatricks.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the countdown to St. Patrick's Day in the status bar."
        },
        "stpatricks.saveMessages.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Occasionally flash a lucky status bar message on save."
        },
        "stpatricks.cycleThemes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Theme labels the status bar click cycles through. Empty = all installed Kobber themes."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/st-patricks-day.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/st-patricks-day.code-snippets"
