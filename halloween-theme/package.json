{
  "name": "spooky-halloween-theme",
  "displayName": "🎃 Halloween Theme",
  "description": "A spooky dark theme for Halloween with emoji typing effects, comment emojis, blood-drip gutter icons and a countdown to Oct 31.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "halloween",
    "pumpkin",
    "orange",
    "purple",
    "spooky",
    "dark",
    "emoji",
    "effects",
    "fun"
  ],
  "contributes": {
    "themes": [
      {
        "label": "🎃 Halloween",
        "uiTheme": "vs-dark",
        "path": "./themes/halloween-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "halloween.cycleTheme",
        "title": "Cycle Color Theme",
        "category": "Halloween"
      },
      {
        "command": "halloween.toggleEffects",
        "title": "Toggle Typing Effects",
        "category": "Halloween"
      },
      {
        "command": "halloween.summon",
        "title": "Summon Spirits",
        "category": "Halloween"
      }
    ],
    "configuration": {
      "title": "Halloween",
      "properties": {
        "halloween.onlyWhenThemeActive": {
          "type": "boolean",
          "default": true,
          "description": "Only run effects while the 🎃 Halloween color theme is active."
        },
        "halloween.typingEffects.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Pop a spooky emoji after the cursor while typing."
        },
        "halloween.typingEffects.every": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 50,
          "description": "Pop an emoji every N keystrokes."
        },
        "halloween.commentEmojis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show 🎃 after TODO, 🩸 FIXME, 🕷️ BUG, 👻 HACK, 💀 XXX, 🕯️ NOTE, 🕸️ DEPRECATED in comments."
        },
        "halloween.gutterIcons.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Blood drip in the gutter on error lines, cobweb on warning lines."
        },
        "halloween.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the countdown to Halloween in the status bar."
        },
        "halloween.saveMessages.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Occasionally flash a spooky status bar message on save."
        },
        "halloween.cycleThemes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Theme labels the status bar click cycles through. Empty = all installed Kobber themes."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/halloween.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/halloween.code-snippets"
