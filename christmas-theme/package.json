  "icon": "icon.png",
  "publisher": "Kobber",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kobber77/vscode-themes",
    "directory": "christmas-theme"
  },
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "galleryBanner": {
    "color": "#0E1626",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
